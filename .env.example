# Copy to .env.local (or set in your hosting provider) and fill in when ready.
# Any value left empty is handled gracefully: store buttons show "Coming soon",
# and contact details are simply not shown.

# Canonical origin of this site, used for SEO, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=

# App store listings.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# The Tayylo web app. When set, "Get started" and "Sign in" link to it.
NEXT_PUBLIC_WEB_APP_URL=

# Public contact address shown in the footer and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp number shown on the contact page, international format (e.g. 2348012345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Social profiles. Defaults assume the @tayylo handle on each network.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form delivery (server only). Uses Resend: https://resend.com
# Without these the form offers visitors a pre-filled email instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
